{
  "name": "mindscope-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "MindScope — free, open-source, offline-first personality & wellbeing self-assessment.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvanLi-0505/MindScope-Personality-Assessment.git"
  },
  "homepage": "https://github.com/EvanLi-0505/MindScope-Personality-Assessment#readme",
  "bugs": {
    "url": "https://github.com/EvanLi-0505/MindScope-Personality-Assessment/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:web": "npm run dev -w @mindscope/app",
    "dev:desktop": "npm run tauri:dev -w @mindscope/app",
    "build:web": "npm run build -w @mindscope/app",
    "build:desktop": "npm run tauri:build -w @mindscope/app",
    "package:portable": "powershell -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "package:web": "powershell -ExecutionPolicy Bypass -File scripts/package-web.ps1",
    "test:release": "powershell -ExecutionPolicy Bypass -File scripts/release-tests.ps1",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @mindscope/app",
    "test:e2e:release": "npm run test:e2e:release -w @mindscope/app",
    "test:rust": "cargo test --manifest-path apps/mindscope/src-tauri/Cargo.toml"
  }
}
